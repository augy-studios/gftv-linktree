# OneLink GFTV, Vercel environment variables.
# Set these in Vercel > Project > Settings > Environment Variables (Production,
# and Preview if you deploy previews). Never commit a filled-in copy.

# The public origin. Passkeys are bound to its hostname, and every
# state-changing request must come from it.
SITE_URL=https://links.gftv.asia

# Supabase > Project Settings > API. The service role key bypasses RLS, so it
# lives here only and never in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=

# 32 random bytes, as 64 hex characters or 44 base64 characters. Encrypts
# owners' authenticator secrets at rest. Make one with:  openssl rand -hex 32
# Changing it later makes every existing authenticator secret unreadable.
TOTP_ENCRYPTION_KEY=

# Any long random string. Salts the hashed IP addresses kept for rate limits
# and reports, so the hashes cannot be reversed with a lookup table.
IP_HASH_SALT=

# Vercel Cron sends this as "Authorization: Bearer <value>" to /api/cron/cleanup.
CRON_SECRET=

# Telegram recovery (optional). Leave blank to switch Telegram off; owners
# then see no Telegram option. Create the bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# The bot's username without the @, for the t.me deep links.
TELEGRAM_BOT_USERNAME=
# Any random string of 1 to 256 characters from A-Z, a-z, 0-9, _ and -.
# Passed to setWebhook as secret_token; see the README.
TELEGRAM_WEBHOOK_SECRET=

# Google Safe Browsing (optional). With a key, links and redirect addresses
# are checked against Google's malware and phishing list when they are saved,
# and every live one again by the daily cron. Blank switches the check off.
# Create the key in Google Cloud: enable "Safe Browsing API", then
# APIs & Services > Credentials > Create credentials > API key.
GOOGLE_SAFE_BROWSING_KEY=

# Domain blocklists for links, no key needed. Blank uses HaGeZi's lists
# (about 2.9 million domains): harmful sites (threat intelligence, fake
# stores, pop-up ads, badware hosting), gambling, URL shorteners, adult
# content and piracy. Otherwise "category:address" pairs separated by commas,
# where category is unsafe, gambling, shortener, adult or piracy and each list is one
# domain or *.domain per line; or "off". The daily cron rebuilds the compact
# copy in the gftvonelink_lists bucket (migration 005) every this many days.
DOMAIN_BLOCKLISTS=
DOMAIN_BLOCKLIST_REFRESH_DAYS=14
